
<%= turbo_stream_from @chat %>

<div class="chat-layout" data-controller="chat">
  <!-- SIDEBAR -->
  <aside class="chat-sidebar" data-chat-target="sidebar">
    <div class="sidebar-header">
      <%= button_to "+ New Chat", stack_chats_path(@stack), method: :post, class: "new-chat-btn" %>
      <button class="sidebar-toggle" data-action="click->chat#closeSidebar">✕</button>
    </div>

    <div class="sidebar-chats" data-base-path="<%= stack_chats_path(@stack) %>">
      <% @stack.chats.where(user: current_user).order(updated_at: :desc).each do |chat| %>
        <div class="sidebar-chat-item-wrapper">
          <%= link_to stack_chat_path(@stack, chat),
              class: "sidebar-chat-item #{'active' if defined?(@chat) && chat == @chat}" do %>
            <span class="chat-item-title"><%= chat.title %></span>
            <span class="chat-item-meta"><%= chat.messages.count %> msgs</span>
          <% end %>

          <div class="chat-item-menu">
            <button class="chat-menu-btn"
                    data-chat-id="<%= chat.id %>"
                    data-action="click->chat#toggleMenu">⋯</button>
            <div class="chat-menu-dropdown" id="chatMenu-<%= chat.id %>">
              <button class="chat-rename-btn"
                      data-chat-id="<%= chat.id %>"
                      data-chat-title="<%= chat.title %>"
                      data-action="click->chat#rename">✏️ Rename</button>
              <%= button_to "🗑️ Delete", stack_chat_path(@stack, chat),
                  method: :delete,
                  class: "chat-menu-delete",
                  data: { turbo_confirm: "Are you sure?" } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </aside>

  <button class="sidebar-open-btn" data-chat-target="openBtn" data-action="click->chat#openSidebar">☰</button>

  <!-- MAIN CHAT -->
  <main class="chat-main">
    <div class="chat-header">
      <span class="chat-title"><%= @chat.title %></span>
    </div>

    <div class="messages-area" data-chat-target="messages">
      <div class="messages-container">
        <%= render @messages %>
      </div>
    </div>

    <div class="input-area">
      <div class="input-container">
        <!-- ↓ ADICIONADO: multipart: true para permitir upload -->
        <%= simple_form_for [@stack, @chat, @message], html: { multipart: true } do |f| %>
          <div class="input-wrapper">
            <%= f.input :content,
                label: false,
                as: :text,
                input_html: {
                  placeholder: "Describe your project...",
                  rows: 4,
                  class: "chat-textarea",
                  id: "chat-input"
                } %>

            <!-- ↓ ADICIONADO: campo de upload -->
            <%= f.input :file, as: :file, label: "📎 PDF, Image or Audio" %>

            <%= f.submit "→", class: "send-btn" %>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>
